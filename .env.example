# Set true only for a demo deployment; explicitly false in production.
DEMO_MODE=true
# Use a random secret of at least 32 bytes for persistent sessions.
SESSION_SECRET=
# Optional server-side Gemini integration. Never use NEXT_PUBLIC_ for these.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT_ID=project-7a0d93e5-ed23-42d1-974
GOOGLE_CLOUD_STORAGE_BUCKET=darknight31
# demo keeps media in browser IndexedDB; gcs enables signed server-authorized uploads.
STORAGE_MODE=demo
# For GCS, use workload identity or Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/service-account.json
# Optional persistent metadata directory, outside the app source in deployments.
# DATA_DIRECTORY=C:/portal-data
